# ══════════════════════════════════════════════════════
#  AA MD Bot — Environment Variables
#  Copy to .env and fill in your values:
#    cp .env.example .env
#    nano .env
# ══════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=5000
SERVER_ID=server-1          # Change per VM: server-1 / server-2 / server-3

# ── Database — pick ONE option ────────────────────────

# ✅ OPTION A — Self-hosted MongoDB on Oracle VM (recommended if MongoDB is on same/another VM)
# Replace 127.0.0.1 with actual VM IP if MongoDB is on a different machine
MONGODB_URI=mongodb://aa_bot_user:YourPassword@127.0.0.1:27017/aa_md_bot

# ✅ OPTION B — Oracle Autonomous Database (ADB) MongoDB API
# Get from: Oracle Cloud Console → Autonomous Database → Database connection → MongoDB API
# MONGODB_URI=mongodb://ADMIN:YourPassword@adb-xxxxxxxx.adb.REGION.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&tls=true&tlsAllowInvalidCertificates=true&retryWrites=false&loadBalanced=true

# ✅ OPTION C — MongoDB Atlas (cloud, 512 MB free)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aa_md_bot?retryWrites=true&w=majority

# ── Telegram Bots (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=                  # Admin pairing bot — get from @BotFather
TELEGRAM_FEATURES_BOT_TOKEN=         # Features mirror bot — second token from @BotFather

# ── Optional API Keys ─────────────────────────────────
OPENWEATHER_API_KEY=        # openweathermap.org/api — for .weather command
OMDB_API_KEY=               # omdbapi.com/apikey.aspx — for .movie command
RAPIDAPI_KEY=               # rapidapi.com
OCR_SPACE_KEY=              # ocr.space/ocrapi — for .ocr command
HF_TOKEN=                   # huggingface.co/settings/tokens — for AI commands
TENOR_API_KEY=              # developers.google.com/tenor — for GIF search

# ── Security ──────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_64_char_string
