# ══════════════════════════════════════════════════════
#  AA MD Bot — Environment Variables Template
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ══════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=5000
SERVER_ID=server-1          # Change to server-2, server-3 on other VMs

# ── Database (MongoDB) ────────────────────────────────
# Option A: Self-hosted MongoDB on Oracle VM (recommended for Oracle Cloud)
MONGODB_URI=mongodb://aa_bot_user:YOUR_STRONG_PASSWORD@10.0.0.X:27017/aa_md_bot

# Option B: MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aa_md_bot

# Option C: Legacy Atlas shorthand (password only, hardcoded cluster)
# MONGODB_PASSWORD=your_atlas_password

# ── Telegram Bots (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=          # Admin/pairing bot token from @BotFather
TELEGRAM_FEATURES_BOT_TOKEN= # Features bot token from @BotFather

# ── API Keys (optional, improves specific commands) ───
OPENWEATHER_API_KEY=         # https://openweathermap.org/api
OMDB_API_KEY=                # https://www.omdbapi.com/apikey.aspx
RAPIDAPI_KEY=                # https://rapidapi.com
OCR_SPACE_KEY=               # https://ocr.space/ocrapi
HF_TOKEN=                    # https://huggingface.co/settings/tokens
TENOR_API_KEY=               # https://developers.google.com/tenor

# ── Session Secret ────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_string_64_chars
