# ══════════════════════════════════════════════════════════════
#  AA MD Bot — Environment Variables
#  Copy to .env and fill in your values:
#    cp .env.example .env
#    nano .env
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=5000
SERVER_ID=server-1          # Change per VM: server-1 / server-2 / server-3

# ── Database ──────────────────────────────────────────────────
#
#  OPTION A — MongoDB Atlas (cloud, free tier) — RECOMMENDED
#    1. atlas.mongodb.com par signup karo
#    2. Free M0 cluster banao
#    3. Database Access → user banao (username + password)
#    4. Network Access → 0.0.0.0/0 allow karo
#    5. Connect → Drivers → URI copy karo
#
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aa_md_bot?retryWrites=true&w=majority

#  OPTION B — MongoDB on a separate VM (private network, e.g. Oracle)
#    On the MongoDB VM run these commands first:
#
#    # 1. MongoDB install (Ubuntu 22.04):
#    #    curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | sudo gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor
#    #    echo "deb [ arch=amd64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" | sudo tee /etc/apt/sources.list.d/mongodb-org-7.0.list
#    #    sudo apt-get update && sudo apt-get install -y mongodb-org
#    #    sudo systemctl enable --now mongod
#
#    # 2. Create database user (in mongosh):
#    #    use aa_md_bot
#    #    db.createUser({ user: "aa_bot_user", pwd: "YourStrongPassword", roles: [{ role: "readWrite", db: "aa_md_bot" }] })
#
#    # 3. Allow remote connections — edit /etc/mongod.conf:
#    #    net:
#    #      bindIp: 0.0.0.0      ← change from 127.0.0.1
#    #    security:
#    #      authorization: enabled
#    #    Then: sudo systemctl restart mongod
#
#    # 4. Firewall — allow port 27017 ONLY from your bot VM private IP:
#    #    sudo ufw allow from 10.0.0.X to any port 27017
#    #    (Oracle Cloud: also add ingress rule in VCN Security List for port 27017)
#
#    authSource MUST be the same database where the user was created (aa_md_bot here):
# MONGODB_URI=mongodb://aa_bot_user:YourStrongPassword@10.0.0.X:27017/aa_md_bot?authSource=aa_md_bot

#  OPTION C — MongoDB on same VM (localhost)
# MONGODB_URI=mongodb://aa_bot_user:YourStrongPassword@127.0.0.1:27017/aa_md_bot?authSource=aa_md_bot

# ── Telegram Bots (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=                  # Admin pairing bot — get from @BotFather
TELEGRAM_FEATURES_BOT_TOKEN=         # Features mirror bot — second token from @BotFather

# ── Optional API Keys ─────────────────────────────────────────
OPENWEATHER_API_KEY=        # openweathermap.org/api — for .weather command
OMDB_API_KEY=               # omdbapi.com/apikey.aspx — for .movie command
RAPIDAPI_KEY=               # rapidapi.com
OCR_SPACE_KEY=              # ocr.space/ocrapi — for .ocr command
HF_TOKEN=                   # huggingface.co/settings/tokens — for AI commands
TENOR_API_KEY=              # developers.google.com/tenor — for GIF search

# ── Security ──────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_64_char_string
