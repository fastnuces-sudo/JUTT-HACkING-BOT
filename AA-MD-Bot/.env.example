# ══════════════════════════════════════════════════════
#  AA MD Bot — Environment Variables Template
#  Copy to .env and fill in your values:
#    cp .env.example .env
# ══════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────
PORT=5000
SERVER_ID=server-1          # server-1 / server-2 / server-3 (change per VM)

# ── Database ──────────────────────────────────────────
# ✅ RECOMMENDED — Oracle Autonomous Database (Always Free, 20 GB)
# Get this URL from Oracle Cloud Console → ADB → DB Connection → MongoDB API
# (Full instructions: deploy/ORACLE-ADB-GUIDE.md)
MONGODB_URI=mongodb://ADMIN:YourPassword@adb-xxxxxxxx.adb.REGION.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&tls=true&tlsAllowInvalidCertificates=true&retryWrites=false&loadBalanced=true

# MongoDB self-hosted on Oracle VM (alternative)
# MONGODB_URI=mongodb://aa_bot_user:password@10.0.0.X:27017/aa_md_bot

# MongoDB Atlas legacy shorthand (only 512 MB — not recommended)
# MONGODB_PASSWORD=your_atlas_password

# ── Telegram Bots (optional) ──────────────────────────
TELEGRAM_BOT_TOKEN=                  # Get from @BotFather
TELEGRAM_FEATURES_BOT_TOKEN=         # Second bot token from @BotFather

# ── Optional API Keys ─────────────────────────────────
OPENWEATHER_API_KEY=        # openweathermap.org/api
OMDB_API_KEY=               # omdbapi.com/apikey.aspx
RAPIDAPI_KEY=               # rapidapi.com
OCR_SPACE_KEY=              # ocr.space/ocrapi
HF_TOKEN=                   # huggingface.co/settings/tokens
TENOR_API_KEY=              # developers.google.com/tenor

# ── Security ──────────────────────────────────────────
SESSION_SECRET=change_this_to_a_random_64_char_string
