# ══════════════════════════════════════════════════════════════
#  Jutts Bot — Environment Variables
#
#  ✅ Oracle VM par deploy karte ho to .env auto-banta hai:
#     bash <(curl -fsSL https://raw.githubusercontent.com/fastnuces-sudo/JUTT-HACkING-BOT/main/deploy/setup.sh)
#
#  Manual setup ke liye neeche dekho:
#     cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=5000
# Local development/Arena: 0.0.0.0. Nginx production: 127.0.0.1.
HOST=0.0.0.0
SERVER_ID=server-1

# ── Database — Neon Postgres ──────────────────────────────────
# Neon Console (https://console.neon.tech) → apna project kholo →
# "Connection Details" → connection string copy karke yahan paste karo.
# Pooled connection string ("-pooler" wala host) recommend kiya jata hai.
#
# Tables (groups, settings, sessions, auth_creds, ...) pehli baar bot
# start hone par automatically ban jate hain — koi manual SQL nahi chahiye.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/jutts_bot?sslmode=require

# Optional: database name override jab URL mein path na ho.
# PGDATABASE=
# Optional: connection pool size (default 10).
# PGPOOL_MAX=10

# ── Security ──────────────────────────────────────────────────
# Oracle deploy automatically generates both values. For a public manual deploy,
# generate DASHBOARD_TOKEN with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_random_64_char_string
DASHBOARD_TOKEN=
# Comma-separated origins only when a separate frontend must call this API.
DASHBOARD_ALLOWED_ORIGINS=

# ── WhatsApp owner permissions ────────────────────────────────
# If blank, the first successfully linked number becomes super owner.
SUPER_OWNER=
# Comma-separated international numbers, digits only.
OWNER_NUMBERS=

# ── Telegram (optional) ───────────────────────────────────────
# TELEGRAM_BOT_TOKEN=          # @BotFather se lena
# TELEGRAM_ADMIN_ID=            # your numeric Telegram user ID
# TELEGRAM_PUBLIC_PAIRING=false # keep false unless intentionally offering public pairing
# TELEGRAM_FEATURES_BOT_TOKEN= # second bot token

# ── API Keys (optional) ───────────────────────────────────────
# OPENWEATHER_API_KEY=   # .weather command ke liye
# OMDB_API_KEY=          # .movie command ke liye
# RAPIDAPI_KEY=
# OCR_SPACE_KEY=         # .ocr command ke liye
# HF_TOKEN=              # AI commands ke liye
# TENOR_API_KEY=         # GIF search ke liye
