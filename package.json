{
  "name": "jutts-bot",
  "version": "3.0.0",
  "description": "Jutts Bot - Multi-Device WhatsApp Bot by Sajid Jutt",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "check": "npm run check:syntax && npm test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1",
    "smoke": "node scripts/smoke.mjs",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart jutts-bot",
    "pm2:logs": "pm2 logs jutts-bot",
    "postinstall": "node -e \"const fs=require('fs');['logs','temp','session','downloads','database','cache'].forEach(d=>{try{fs.mkdirSync(d,{recursive:true})}catch{}});console.log('✅ Directories ready');\""
  },
  "keywords": [
    "whatsapp",
    "bot",
    "md",
    "baileys",
    "oracle"
  ],
  "author": "Sajid Jutt (Jutts Mods)",
  "license": "MIT",
  "dependencies": {
    "@fantox01/lyrics-scraper": "^4.0.0",
    "@fantox01/search-it": "^1.0.0",
    "@gradio/client": "^2.3.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "archiver": "^8.0.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "figlet": "^1.11.3",
    "form-data": "^4.0.6",
    "fs-extra": "^11.2.0",
    "jimp": "^1.6.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "mongodb": "^7.5.0",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-telegram-bot-api": "^1.2.0",
    "node-webpmux": "^3.2.1",
    "pino": "^9.4.0",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.2"
  }
}
